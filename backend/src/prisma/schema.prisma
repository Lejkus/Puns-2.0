datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  nickname  String   @unique
  password  String
  points    Int      @default(0)
  gamesPlayed Int    @default(0)
  wins      Int      @default(0)
  createdAt DateTime @default(now())
}

model Room {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  password  String?
  status   String  @default("LOBBY") // Dodajemy to: LOBBY lub IN_GAME
  createdAt DateTime @default(now())
}